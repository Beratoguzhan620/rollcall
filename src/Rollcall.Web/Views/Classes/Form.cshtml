@model ClassFormModel
@{
    ViewData["Title"] = Model.IsEdit ? "Sınıfı düzenle" : "Yeni sınıf";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Sınıflar</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
    </ol>
</nav>

<div class="page-header">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p>Sınıf adı seviye ve şubeden oluşur, ör. 9-A. Aynı ad iki kez kullanılamaz.</p>
    </div>
</div>

<form class="card form-card" method="post" asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" novalidate>
    <div class="card-body">
        <partial name="Partials/_ViewMessages" />
        <div class="row g-3">
            <div class="col-6 col-sm-4">
                <label class="form-label" asp-for="GradeLevel"></label>
                <select class="form-select" asp-for="GradeLevel">
                    <option value="">Seçin</option>
                    @for (var level = 1; level <= 12; level++)
                    {
                        <option value="@level" selected="@(Model.GradeLevel == level)">@level. sınıf</option>
                    }
                </select>
                <span class="field-validation-error" asp-validation-for="GradeLevel"></span>
            </div>
            <div class="col-6 col-sm-3">
                <label class="form-label" asp-for="Section"></label>
                <input class="form-control text-uppercase" asp-for="Section" maxlength="2" autocomplete="off" placeholder="A" />
                <span class="field-validation-error" asp-validation-for="Section"></span>
            </div>
            <div class="col-12 col-sm-7">
                <label class="form-label" asp-for="AdvisorName"></label>
                <input class="form-control" asp-for="AdvisorName" autocomplete="off" />
                <div class="form-text">İsteğe bağlı.</div>
                <span class="field-validation-error" asp-validation-for="AdvisorName"></span>
            </div>
            <div class="col-12 col-sm-5">
                <label class="form-label" asp-for="Room"></label>
                <input class="form-control" asp-for="Room" autocomplete="off" placeholder="B-104" />
                <span class="field-validation-error" asp-validation-for="Room"></span>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a class="btn btn-outline-secondary" asp-action="@(Model.IsEdit ? "Detail" : "Index")" asp-route-id="@Model.Id">Vazgeç</a>
        <button class="btn btn-primary" type="submit">@(Model.IsEdit ? "Kaydet" : "Sınıfı ekle")</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
