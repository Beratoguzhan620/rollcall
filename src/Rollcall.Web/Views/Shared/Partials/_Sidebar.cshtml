@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? " active" : string.Empty;
    string? Current(string name) => Active(name).Length > 0 ? "page" : null;
}

<aside class="app-sidebar offcanvas-lg offcanvas-start" id="appSidebar" tabindex="-1" aria-label="Ana menü">
    <div class="offcanvas-header border-bottom d-lg-none">
        <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark" style="background: var(--rc-accent)">R</span>Rollcall</a>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#appSidebar" aria-label="Kapat"></button>
    </div>

    <div class="sidebar-inner">
        <nav>
            <div class="nav-section-title">Genel</div>
            <a class="side-link@(Active("Home"))" aria-current="@Current("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i>Özet</a>
        </nav>
        <nav>
            <div class="nav-section-title">Günlük</div>
            <a class="side-link@(Active("Attendance"))" aria-current="@Current("Attendance")" asp-controller="Attendance" asp-action="Index"><i class="bi bi-check2-square"></i>Yoklama</a>
            <a class="side-link@(Active("Exams"))" aria-current="@Current("Exams")" asp-controller="Exams" asp-action="Index"><i class="bi bi-journal-text"></i>Sınavlar ve notlar</a>
        </nav>
        <nav>
            <div class="nav-section-title">Okul</div>
            <a class="side-link@(Active("Classes"))" aria-current="@Current("Classes")" asp-controller="Classes" asp-action="Index"><i class="bi bi-grid-3x2-gap"></i>Sınıflar</a>
            <a class="side-link@(Active("Students"))" aria-current="@Current("Students")" asp-controller="Students" asp-action="Index"><i class="bi bi-people"></i>Öğrenciler</a>
        </nav>

        <div class="sidebar-footer">Rollcall · @DateTime.UtcNow.Year</div>
    </div>
</aside>
