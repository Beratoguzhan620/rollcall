<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- SQLitePCLRaw.lib.e_sqlite3 2.1.11 (through Microsoft.EntityFrameworkCore.Sqlite) is reported for the SQLite it
         bundles. That native SQLite is left out below; the one loaded comes from SourceGear.sqlite3 in Rollcall.Data,
         a build with the fix, and a test checks the version at run time. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.11" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>
</Project>
