@model List<StudentDetailViewModel>

<h3>Öğrenciler</h3>

<a asp-controller="Students" asp-action="Create" class="btn btn-success mb-2">Öğrenci Ekle</a>

<table class="table table-striped table-hover">

    <thead>
        <tr>
            <th>Id</th>
            <th>Ad</th>
            <th>Soyad</th>
            <th>Sınıf</th>
            <th>İşlemler</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.Id</td>
                <td>@student.FirstName</td>
                <td>@student.LastName</td>
                <td>@student.ClassName</td> 
                <td>
                    <a asp-controller="Students" asp-action="Detail" asp-route-id="@student.Id" class="btn btn-primary">Detay</a>
                    <a asp-controller="Students" asp-action="Edit" asp-route-id="@student.Id" class="btn btn-warning">Düzenle</a>
                    <a asp-controller="Students" asp-action="Delete" asp-route-id="@student.Id" class="btn btn-danger">Sil</a>
                </td>
        </tr>
    }
</tbody>

</table>

